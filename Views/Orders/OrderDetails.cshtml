@{
    ViewData["Title"] = "Order Details";
    ViewData["HideButton"] = true;
}

@using System.Globalization
@using asp_dot_net_core_web_app_mvc_fast_food_system.Enums
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.Base
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.Interface

@model Order

<div class="container order-details-page">
    <div class="flex">
        <div>
            <a asp-action="Index" asp-controller="Orders">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
        </div>
        <div class="edit-order">
            <a asp-action="EditOrder" asp-controller="Orders" asp-route-id="@Model.Id">
                <i class="fa fa-edit"></i> Edit Order
            </a>
        </div>
    </div>
    <div class="flex">
        <h2>
            Order nº: @Model.Number
            @if (!String.IsNullOrEmpty(Model.CustomerPhoneNumber))
            {
                <span>(@Model.CustomerPhoneNumber)</span>
            }
        </h2>
        <h2>Ready at: <span class="order-ready-time">@Model.ReadyTime.ToString("t")</span></h2>
    </div>
    <div class="flex order-type">
        <h3>@Html.DisplayFor(m => @Model.Type)</h3>
        @if (Model.Type == OrderType.Delivery)
        {
            <div class="order-customer-address">
                <h4>@($"({Model.CustomerAddress})" ?? "")</h4>
            </div>
        }
    </div>
    <partial name="_ProductItemsFields" model="Model.OrderProducts.OfType<IProductItem>()" />
    <div class="flex order-summary">
        <div>
            <h3>Total Items: @Model.Quantity</h3>
            @if (!String.IsNullOrEmpty(Model.Observations))
            {
                <div class="observations">
                    <h3>Observations:</h3>
                    <p>@Model.Observations</p>
                </div>                
            }
        </div>
        <div class="flex order-summary-price">
            @if (Model.AdditionalCharge != null && Model.AdditionalCharge != 0m)
            {
                <div class="food-total">
                    <div class="flex order-food-total-price">
                        <h3 class="key">Food Total:</h3>
                        <h3 class="value">@Model.FoodTotalPrice.ToString("C", new CultureInfo("en-CA"))</h3>
                    </div>
                    <div class="flex order-additional-charge-price">
                        @if (Model.AdditionalCharge != null && Model.AdditionalCharge != 0m)
                        {
                            <h3 class="key">Additional Charge:</h3>
                            <h3 class="value">@Model.AdditionalCharge.Value.ToString("C", new CultureInfo("en-CA"))</h3>
                        }
                    </div>
                </div>                
            }
            <div class="flex order-subtotal-price ">
                <h3 class="key">SubTotal:</h3>
                <h3 class="value">@Model.SubTotalPrice.ToString("C", new CultureInfo("en-CA"))</h3>
            </div>
            <div class="flex order-gst-price">
                <h3 class="key">GST:</h3>
                <h3 class="value">@Model.Gst.ToString("C", new CultureInfo("en-CA"))</h3>
            </div>
            <div class="flex order-pst-price">
                <h3 class="key">PST:</h3>
                <h3 class="value">@Model.Pst.ToString("C", new CultureInfo("en-CA"))</h3>
            </div>
            <div class="flex order-delivery-price">
                @if (Model.DeliveryFee != null && Model.DeliveryFee != 0m)
                {
                    <h3 class="key">Delivery Fee:</h3>
                    <h3 class="value">@Model.DeliveryFee.Value.ToString("C", new CultureInfo("en-CA"))</h3>
                }
            </div>
            <div class="flex order-discount-price">
                @if (Model.Discount != null && Model.Discount != 0m)
                {
                    <h3 class="key">Discount:</h3>
                    <h3 class="value">@Model.Discount.Value.ToString("C", new CultureInfo("en-CA"))</h3>
                }
            </div>
            <div class="flex order-total-price">
                <h3 class="key">Total:</h3>
                <h3 class="value">@Model.TotalPrice.ToString("C", new CultureInfo("en-CA"))</h3>
            </div>
        </div>
    </div>
    <div class="print-receipt">
        <form asp-action="PrintOrder" asp-controller="ThermalPrinter" asp-route-id="@Model.Id" class="print-order-form">
            <button type="submit" class="button">
                <i class="fa-solid fa-print"></i>
            </button>
            <partial name="_PrintOrderCheckbox" />
        </form>
    </div>
</div>
