@model Order

@{
    ViewData["Title"] = "Edit Order";

    ViewData["OrderFormAction"] = "EditOrder";
    ViewData["OrderFormController"] = "Orders";
    ViewData["OrderFormSubmitButtonTitle"] = "Save Changes";
}

@using System.Globalization
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.Base

<partial name="_AddProductInput" />
<div class="container edit-order-page">
    <div>
        <a asp-action="OrderDetails" asp-controller="Orders" asp-route-id="@Model.Id">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
    </div>
    <div class="flex">
        <h2>
            Order nº: @Model.Number
            @if (!String.IsNullOrEmpty(Model.CustomerPhoneNumber))
            {
                <span>(@Model.CustomerPhoneNumber)</span>
            }
        </h2>
        <h2>Ready at: <span class="order-ready-time">@Model.ReadyTime.ToString("t")</span></h2>
    </div>
    <div class="order-products">
        <div class="order-product-template">
            <span class="product-code">Code</span>
            <span class="product-name">Product</span>
            <span class="product-price">Price</span>
            <span class="product-additional-price">Additional Price</span>
            <span class="product-quantity">Quantity</span>
            <span class="product-total-price">Total Price</span>
            <span class="product-increment-button"></span>
            <span class="product-decrement-button"></span>
        </div>
        @foreach (OrderProduct orderProduct in Model.OrderProducts.OrderBy(
            op => // order by product's code
            {
                string code = op.Product.Code;
                int i = 0;

                while (i < code.Length && char.IsDigit(code[i]))
                {
                    i++;
                }

                if (i > 0)
                {
                    int number = int.Parse(code.Substring(0, i));
                    string letter = code.Substring(i);

                    return (0, number, letter); // tuple (group, number, text)
                    // 0: "code starts with a digit"
                    // number: the numeric part found
                    // letter: the remaining text
                }
                else
                {
                    return (1, 0, code);
                    // 1: "code starts with a letter"
                    // 0: no number
                    // code: entire string
                }
            }))
        {
            <div class="order-product">
                <span class="product-code">@orderProduct.Product.Code</span>
                <span class="product-name">@orderProduct.Product.Name</span>
                <span class="product-price">@orderProduct.Price.ToString("C", new CultureInfo("en-CA"))</span>
                <span class="product-additional-price">
                    @orderProduct.AdditionalPrice.ToString("C", new CultureInfo("en-CA"))
                    <button class="button button-additional-price"><i class="fa-solid fa-pen-to-square"></i></button>
                    <partial name="_ProductsAdditionalPriceAndInstructionsModal" model="@orderProduct" />
                </span>
                <span class="product-quantity">@orderProduct.Quantity</span>
                <span class="product-total-price">@orderProduct.TotalPrice.ToString("C", new CultureInfo("en-CA"))</span>
                <a asp-action="IncrementProduct" asp-controller="Orders" asp-route-id="@orderProduct.Id">
                    <span class="button product-increment">+</span>
                </a>
                <a asp-action="DecrementProduct" asp-controller="Orders" asp-route-id="@orderProduct.Id">
                    <span class="button product-decrement">-</span>
                </a>
            </div>
        }
    </div>
    <partial name="_OrderForm" />
</div>

@section Scripts {
    <script src="~/js/Shared/order-form.js"></script>
    <script src="~/js/additionalPriceModal.js"></script>
}
