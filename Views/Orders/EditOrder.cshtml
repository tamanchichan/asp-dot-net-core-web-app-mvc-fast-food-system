@model Order

@{
    ViewData["Title"] = "Edit Order";

    ViewData["ReadyDateOnly"] = Model.ReadyTime.ToString("yyyy-MM-dd");
    ViewData["ReadyTimeOnly"] = Model.ReadyTime.ToString("HH:mm");

    // ViewData["OrderFormButtonOnClick"] = "handlePlaceOrder()";
    ViewData["OrderFormButtonType"] = "submit";

    ViewData["OrderFormSubmitButtonTitle"] = "Save Changes";
}

@using System.Globalization
@using asp_dot_net_core_web_app_mvc_fast_food_system.Enums
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.Base
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.Interface

<div class="container edit-order-page">
    <partial name="_ProductsAdditionalPriceAndInstructionsModal" />
    <div class="form">
        @* <form asp-action="AddProductToOrder" asp-controller="Orders" asp-route-id="@Model.Id" method="post"> *@
            <input type="hidden" id="orderId" value="@Model.Id" />
            <partial name="_AddProductInput" model="@Model" />
        @* </form> *@
    </div>
    <div class="page-header flex">
        <a asp-action="OrderDetails" asp-controller="Orders" asp-route-id="@Model.Id">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <a asp-action="CancelOrder" asp-controller="Orders" asp-route-id="@Model.Id">
            <i class="fa-solid fa-ban"></i>
        </a>
    </div>
    <div class="flex order-type-and-order-ready-date">
        <h3>@Html.DisplayFor(m => @Model.Type)</h3>
        @if (Model.Type == OrderType.Delivery)
        {
            <div class="order-customer-address">
                @if (!String.IsNullOrEmpty(Model.CustomerAddress))
                {
                    <h4>(@(Model.CustomerAddress))</h4>
                }
            </div>
        }
        <h3><span class="order-ready-date">@Model.ReadyTime.ToString("yyyy-MM-dd")</span></h3>
    </div>
    <div class="flex order-number-and-order-ready-time">
        <h3>Order nº: @Model.Number</h3>
        <h3>Ready at: <span class="order-ready-time">@Model.ReadyTime.ToString("t")</span></h3>
    </div>
    <div class="order-product-quantity flex">
        <h3>Items: <span id="orderItems">@Model.OrderProducts.Count()</span></h3>
        <h3>Total Items: <span id="orderTotalItems">@Model.Quantity</span></h3>
    </div>
    <partial name="_ProductItemsFields" model="Model.OrderProducts" />
    <div class="form">
        <form asp-action="EditOrder" asp-controller="Orders" asp-route-id="@Model.Id" method="post"id="orderFormOrder">
            <partial name="_OrderForm"/>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/Views/Shared/_OrderForm.js"></script>
    <script src="~/js/orderFormDetails.js"></script>
    <script src="~/js/additionalPriceModal.js"></script>
    <script type="module">
        import { incrementProductQuantity, decrementProductQuantity } from "/js/Views/Shared/_ProductItemsFields.js";
        window.incrementProductQuantity = incrementProductQuantity;
        window.decrementProductQuantity = decrementProductQuantity;

        import { addProductInput } from "/js/Views/Shared/_AddProductInput.js";
        window.addProductInput = () => addProductInput("Order");

        window.orderId = "@Model.Id";
    </script>
}
