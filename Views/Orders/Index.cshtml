@{
    ViewData["Title"] = "Orders Page";

    ViewData["SearchForm"] = "SearchOrder";
    ViewData["SearchId"] = "orderNumber";
    ViewData["SearchName"] = "orderNumber";
    ViewData["SearchPlaceholder"] = "Order nº";
    ViewData["SearchController"] = "Orders";
}

@using System.Globalization
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.Base
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.PaginatedList

@* @model HashSet<Order> *@
@model PaginatedList<Order>

<div class="container orders-page">
    @if (Model == null)
    {
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    }
    else
    {
        <partial name="_SearchBar" />
        <form asp-action="Index" method="get" class="orders-filter-form">
            <div class="orders-filter-date">
                <label for="date">Orders for:</label>
                <input type="date" id="date" name="date" value="@ViewBag.SelectedDate.ToString("yyyy-MM-dd")" />
            </div>

            <div class="orders-filter-display">
                <div class="display-all-orders">
                    <input type="radio" name="orderFilter" id="displayAllOrders" value="allOrders" checked="@(ViewBag.OrderFilter == "allOrders")" onchange="this.form.submit()" />
                    <label for="displayAllOrders">All Orders</label>
                </div>

                <div class="display-active-orders">
                    <input type="radio" name="orderFilter" id="displayActiveOrders" value="activeOrders" checked="@(ViewBag.OrderFilter == "activeOrders")" onchange="this.form.submit()" />
                    <label for="displayActiveOrders">Active Orders</label>
                </div>

                <div class="display-canceled-orders">
                    <input type="radio" name="orderFilter" id="displayCanceledOrders" value="canceledOrders" checked="@(ViewBag.OrderFilter == "canceledOrders")" onchange="this.form.submit()" />
                    <label for="displayCanceledOrders">Canceled Orders</label>
                </div>
            </div>
        </form>
        <div class="orders">
            @foreach (Order order in Model)
            {
                <a asp-action="OrderDetails" asp-controller="Orders" asp-route-id="@order.Id">
                    <div class="order @(order.IsCanceled == true ? "order-canceled" : "")">
                        <div class="flex">
                            <h3>
                                Order nº: @order.Number
                                @if (!String.IsNullOrEmpty(order.CustomerPhoneNumber))
                                {
                                    <span>(@order.CustomerPhoneNumber)</span>
                                }
                            </h3>
                            <h3>Ready at: <span class="order-ready-time">@order.ReadyTime.ToString("t")</span></h3>
                        </div>
                        <div class="flex order-type">
                            <h3>@Html.DisplayFor(m => @order.Type)</h3>
                        </div>
                        <div class="flex">
                            <span>Nº of Items: @order.Quantity</span>
                            <span class="order-total-price">Total Price: @order.TotalPrice.ToString("C", new CultureInfo("en-CA"))</span>
                        </div>
                    </div>
                </a>
            }
        </div>
        <div class="pagination flex">
            @{
                var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                var nextDisabled = !Model.HasNextPage ? "disabled" : "";
            }
            <a 
                asp-action="Index"
                asp-route-page="@(Model.PageIndex - 1)"
                asp-route-date="@ViewBag.SelectedDate.ToString("yyyy-MM-dd")"
                asp-route-orderFilter="@ViewBag.OrderFilter"
                class="button previous-page @prevDisabled"
            >
                Previous
            </a>

            <span>
                Page @Model.PageIndex of @Model.TotalPages
            </span>

            <a
                asp-action="Index"
                asp-route-page="@(Model.PageIndex + 1)"
                asp-route-date="@ViewBag.SelectedDate.ToString("yyyy-MM-dd")"
                asp-route-orderFilter="@ViewBag.OrderFilter"
                class="button next-page @nextDisabled"
            >
                Next
            </a>
        </div>
    }
</div>

<script>
    const dateInput = document.getElementById("date");

    // Prevent keyboard input
    dateInput.addEventListener("keydown", (e) => {
        e.preventDefault();
    });

    // Prevent pasting dates
    dateInput.addEventListener("paste", (e) => {
        e.preventDefault();
    });

    // Another way of 'onchange="this.form.submit()"'
    dateInput.addEventListener("change", () => {
        const selectedDate = dateInput.value;

        if (!selectedDate) return;

        const url = new URL(window.location.href);
        url.searchParams.set("date", selectedDate);

        window.location.href = url.toString();
    });
</script>
