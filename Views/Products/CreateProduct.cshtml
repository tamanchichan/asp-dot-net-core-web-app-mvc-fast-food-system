@{
    ViewData["Title"] = "Create Product";
}

<div class="container create-product-page">
    <h2>Create Product: </h2>
    <form asp-action="CreateProduct" asp-controller="Products" method="post" class="create-product-form">
        <div class="product-category">
            <label for="category">Product Category: </label>
            <select name="category">
                @foreach (var category in ViewBag.Categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
        <div class="product-code">
            <label for="code">Product Code: </label>
            <input type="text" name="code" value="@(TempData["ProductCode"] ?? "")" />
        </div>
        <div class="product-name">
            <label for="name">Product Name: </label>
            <input type="text" name="name" value="@(TempData["ProductName"] ?? "")" />
        </div>
        <div class="product-price">
            <label for="price">Product Price: </label>
            <input type="number" step="0.01" name="price" value="@(TempData["ProductPrice"] ?? "")" />
        </div>
        <div class="product-option">
            <label for="option">Product Option: </label>
            <input type="checkbox" name="option" value="true" />
        </div>
        <div class="form-buttons">
            <button type="submit" class="button submit-button">Create Product</button>
        </div>
    </form>
</div>