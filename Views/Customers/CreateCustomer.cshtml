@{
    ViewData["Title"] = "Create Customer Page";
}

<div class="container create-customer-page">
    <div class="page-header">
        <a asp-action="Index">
            <i class="fa-solid fa-arrow-left"></i>
        </a>
        <h2>Create Customer</h2>
    </div>
    <div class="create-customer-form">
        <form asp-action="CreateCustomer" method="post" autocomplete="off">
            <h3>Customer's Details:</h3>
            <div class="customer-name">
                <label for="customerName">Name:</label>
                <input type="text" id="customerName" name="customerName" value="@(TempData["CustomerName"] ?? "")" />
            </div>
            <div class="customer-phone-number">
                <label for="customerPhoneNumber">Phone Number:</label>
                <input 
                    type="tel"
                    pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"
                    title="Phone number must be in the format 123-456-7890"
                    id="customerPhoneNumber" 
                    name="customerPhoneNumber"
                    value="@(TempData["ErrorMessage"] ?? "")"
                />
            </div>
            <div class="customer-address">
                <label for="customerAddress">Address:</label>
                <input type="text" id="customerAddress" name="customerAddress" value="@(TempData["CustomerAddress"] ?? "")" />
            </div>
            <div class="form-actions">
                <a asp-action="Index" class="button cancel-button">Cancel</a>
                <button type="submit" class="button confirm-button">Confirm</button>
            </div>
        </form>
    </div>
</div>

<script>
    const phoneInput = document.getElementById("customerPhoneNumber");

    phoneInput.addEventListener("input", (e) => {
        let value = e.target.value.replace(/\D/g, "");

        value = value.substring(0, 10);

        if (value.length > 6) {
            value =
                value.substring(0, 3) + "-" +
                value.substring(3, 6) + "-" +
                value.substring(6);
        }
        else if (value.length > 3) {
            value =
                value.substring(0, 3) + "-" +
                value.substring(3);
        }

        e.target.value = value;
    });
</script>
