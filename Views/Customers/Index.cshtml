@{
    ViewData["Title"] = "Customers Page";

    ViewData["SearchForm"] = "SearchCustomer";
    ViewData["SearchId"] = "phoneNumber";
    ViewData["SearchName"] = "phoneNumber";
    ViewData["SearchPlaceholder"] = "123-456-7890";
    ViewData["SearchController"] = "Customers";
}

@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.Base
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.PaginatedList

@model PaginatedList<Customer>

<div class="container customers-page">
    <partial name="_SearchBar" />
    <div class="flex page-header">
        <h2>Customers List</h2>
        <a asp-action="CreateCustomer" class="button create-button">Create New Customer</a>
    </div>
    <div class="customers-list">
        <div class="customers-list-template">
            <div class="customer-name">Name</div>
            <div class="customer-phone-number">Phone Number</div>
            <div class="customer-address">Address</div>
        </div>
        @foreach (Customer customer in Model)
        {
            <a asp-action="CustomerDetails" asp-route-id="@customer.Id">
                <div class="customer-list">
                    <div class="customer-name">@(customer.Name ?? "NULL")</div>
                    <div class="customer-phone-number">@(customer.PhoneNumber ?? "NULL")</div>
                    <div class="customer-address">@(customer.Address ?? "NULL")</div>
                </div>
            </a>
        }
    </div>
    <div class="pagination flex">
        @{
            var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
            var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        }
        <a asp-action="Index"
           asp-route-page="@(Model.PageIndex - 1)"
           class="button previous-page @prevDisabled">
            Previous
        </a>

        <span>
            Page @Model.PageIndex of @Model.TotalPages
        </span>

        <a asp-action="Index"
           asp-route-page="@(Model.PageIndex + 1)"
           class="button next-page @nextDisabled">
            Next
        </a>
    </div>
</div>