@{
    bool hideButton = ViewData["HideButton"] as bool? ?? false;
}

@model IEnumerable<IProductItem>

@using System.Globalization
@using asp_dot_net_core_web_app_mvc_fast_food_system.Enums;
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.Base;
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.CartProducts;
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.Interface
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.OrderProducts;

<link rel="stylesheet" href="~/css/Views/Shared/_ProductItemsFields.css" />
<div class="product-items">
    @* Moved to Cart's Index view and Order's EditOrder view *@
    @* <partial name="_ProductsAdditionalPriceAndInstructionsModal" /> *@
    <div class="product-items-template" style="@(hideButton ?"grid-template-columns: repeat(6, 1fr);" : "")">
        <span class="product-code">Code</span>
        <span class="product-name">Name</span>
        <span class="product-price">Price</span>
        <span class="product-additional-price">Additional Price</span>
        <span class="product-quantity">Quantity</span>
        <span class="product-total-price">Total Price</span>
        @if (hideButton != true)
        {
            <span class="product-increment-button"></span>
            <span class="product-decrement-button"></span>
        }
    </div>

    @foreach (var productItem in Model.OrderBy
    (
        item => // order item by product's code
        {
            string code = item.Code;
            int i = 0;

            while (i < code.Length && char.IsDigit(code[i]))
            {
                i++;
            }

            if (i > 0)
            {
                int number = int.Parse(code.Substring(0, i));
                string letter = code.Substring(i);

                return (0, number, letter); // tuple (group, number, text)
                // 0: "code starts with a digit"
                // number: the numeric part found
                // letter: the remaining text
            }
            else
            {
                return (1, 0, code);
                // 1: "code starts with a letter"
                // 0: no number
                // code: entire string
            }
        }
    ))
    {
        <div class="product-item" data-id="@productItem.Id" data-additional-price="@productItem.AdditionalPrice.ToString(CultureInfo.InvariantCulture)" data-instructions="@productItem.Instructions">
            <div class="item" style="@(hideButton ? "grid-template-columns: repeat(6, 1fr);" : "")">
                @* @if (
                    productItem.Category == ProductCategory.Beverages ||
                    productItem.Category == ProductCategory.Extras ||
                    productItem.Category == ProductCategory.Sauces
                )
                {
                    <span class="product-code"></span>
                }
                else
                {
                    string optionCode = "";

                    if (productItem is CartFoodProduct cartFood && cartFood.FoodOption.HasValue)
                    {
                        optionCode = cartFood.FoodOption.Value.ToString().Substring(0, 1);
                    }
                    else if (productItem is OrderFoodProduct orderFood && orderFood.FoodOption.HasValue)
                    {
                        optionCode = orderFood.FoodOption.Value.ToString().Substring(0, 1);
                    }
                    <span class="product-code">
                        @($"{productItem.Code}{optionCode}")
                    </span>
                } *@
                @{
                    string optionCode = "";

                    if (productItem is CartFoodProduct cartFoodProduct && cartFoodProduct.FoodOption.HasValue)
                    {
                        optionCode = cartFoodProduct.FoodOption.Value.ToString().Substring(0, 1);
                    }
                    else if (productItem is OrderFoodProduct orderFoodProduct && orderFoodProduct.FoodOption.HasValue)
                    {
                        optionCode = orderFoodProduct.FoodOption.Value.ToString().Substring(0, 1);
                    }
                    <span class="product-code">
                        @($"{productItem.Code}{optionCode}")
                    </span>
                }
                <span class="product-name">
                    @productItem.Name
                    @if (productItem.HasOptions == true)
                    {
                        @if (productItem is CartFoodProduct cartFood)
                        {
                            @(cartFood.FoodOption.HasValue? cartFood.FoodOption.Value.ToString() : "")
                        }
                        else if (productItem is OrderFoodProduct orderFood)
                        {
                            @(orderFood.FoodOption.HasValue? orderFood.FoodOption.Value.ToString() : "")
                        }
                    }
                    @if (productItem is CartSauceProduct cartSauce)
                    {
                        @if (!string.IsNullOrEmpty(cartSauce.SauceOption.ToString()))
                        {
                            @Html.DisplayFor(model => cartSauce.SauceOption)
                        }
                    }
                    else if (productItem is OrderSauceProduct orderSauce)
                    {
                        @if (!string.IsNullOrEmpty(orderSauce.SauceOption.ToString()))
                        {
                            @Html.DisplayFor(model => orderSauce.SauceOption)
                        }
                    }
                </span>
                <span class="product-price">@productItem.Price.ToString("C", new CultureInfo("en-CA"))</span>
                <span class="product-additional-price">
                    @productItem.AdditionalPrice.ToString("C", new CultureInfo("en-CA"))
                    @if (hideButton != true)
                    {
                        <button class="button button-additional-price"><i class="fa-solid fa-pen-to-square"></i></button>
                        @* <partial name="_ProductsAdditionalPriceAndInstructionsModal" model="productItem" /> *@
                    }
                </span>
                <span class="product-quantity">@productItem.Quantity</span>
                <span class="product-total-price">@productItem.TotalPrice.ToString("C", new CultureInfo("en-CA"))</span>
                @if (hideButton != true)
                {
                    <button class="button product-increment" style="@(hideButton ? "display: none;" : "null")" onclick="incrementProductQuantity('@productItem.Id')" type="button">+</button>
                    <button class="button product-decrement" style="@(hideButton ? "display: none;" : "null")" onclick="decrementProductQuantity('@productItem.Id')" type="button">-</button>
                }
            </div>
            @if (!string.IsNullOrEmpty(productItem.Instructions))
            {
                <div class="product-instructions">
                    @productItem.Instructions
                </div>
            }
        </div>
    }
</div>
