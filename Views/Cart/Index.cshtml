@{
    ViewData["Title"] = "Cart Page";

    ViewData["OrderFormAction"] = "PlaceCartOrder";
    ViewData["OrderFormController"] = "Cart";
    ViewData["OrderFormId"] = "orderFormCart";

    ViewData["OrderFormButtonOnClick"] = "handlePlaceOrder()";
    ViewData["OrderFormButtonType"] = "button";

    ViewData["ReadyDateOnly"] = DateTime.Now.ToString("yyyy-MM-dd");
    ViewData["ReadyTimeOnly"] = DateTime.Now.AddMinutes(15).ToString("HH:mm");

    ViewData["OrderFormSubmitButtonTitle"] = "Place Order";
}

@using System.Globalization
@using asp_dot_net_core_web_app_mvc_fast_food_system.Enums
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.Base;
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.CartProducts
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.Interface

@model Cart

@* <link rel="stylesheet" href="~/css/Views/Shared/_ProductItemsFields.css" /> *@

<partial name="_AddProductInput" />
<div class="container cart-page">
    <div class="clear-cart">
        <a asp-action="ClearCartProducts" asp-controller="Cart">
            <i class="fa-solid fa-trash"></i>
        </a>
    </div>
    <partial name="_ProductItemsFields" model="Model.CartProducts" />
    <partial name="_OrderForm" />
</div>

@section Scripts {
    <script src="~/js/Views/Shared/_OrderForm.js"></script>
    <script src="~/js/additionalPriceModal.js"></script>
    <script src="~/js/orderFormDetails.js"></script>
    <script type="module">
        import { incrementProductQuantity, decrementProductQuantity } from "/js/Views/Shared/_ProductItemsFields.js";

        window.incrementProductQuantity = incrementProductQuantity;
        window.decrementProductQuantity = decrementProductQuantity;
    </script>
    @* <script type="module">
        import { addProductInput } from "/js/Views/Shared/_AddProductInput.js";

        window.addProductInput = addProductInput;
    </script> *@
    <script type="module">
        import { handlePlaceOrder } from "/js/Views/Shared/_FreeOrderProduct.js";

        window.handlePlaceOrder = handlePlaceOrder;
    </script>
}
