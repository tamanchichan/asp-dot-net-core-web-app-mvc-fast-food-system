@{
    ViewData["Title"] = "Cart Page";

    ViewData["ProductsAdditionalFormAction"] = "EditProductAdditionalPrice";
    ViewData["ProductsAdditionalFormController"] = "Cart";

    ViewData["OrderFormAction"] = "PlaceCartOrder";
    ViewData["OrderFormController"] = "Cart";
    ViewData["OrderFormSubmitButtonTitle"] = "Place Order";
}

@using System.Globalization
@using asp_dot_net_core_web_app_mvc_fast_food_system.Enums
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.Base;
@using asp_dot_net_core_web_app_mvc_fast_food_system.Models.CartProducts

@model Cart

<partial name="_AddProductInput" />
<div class="container cart-page">
    @if (Model == null)
    {
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    }
    else if (Model.CartProducts == null || Model.CartProducts.Count == 0)
    {
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    }
    else
    {
        <div class="clear-cart">
            <a asp-action="ClearCartProducts" asp-controller="Cart">
                <i class="fa-solid fa-trash"></i>
            </a>
        </div>
        <div class="cart-products">
            <div class="cart-products-template">
                <span class="product-code">Code</span>
                <span class="product-name">Name</span>
                <span class="product-price">Price</span>
                <span class="product-additional-price">Additional Price</span>
                <span class="product-quantity">Quantity</span>
                <span class="product-total-price">Total Price</span>
                <span class="product-increment-button"></span>
                <span class="product-decrement-button"></span>
            </div>
            @foreach (CartProduct cartProduct in Model.CartProducts.OrderBy
            (
                cp => // order cartProduct by product's code
                {
                    string code = cp.Product.Code;
                    int i = 0;

                    while (i < code.Length && char.IsDigit(code[i]))
                    {
                        i++;
                    }

                    if (i > 0)
                    {
                        int number = int.Parse(code.Substring(0, i));
                        string letter = code.Substring(i);

                        return (0, number, letter); // tuple (group, number, text)
                        // 0: "code starts with a digit"
                        // number: the numeric part found
                        // letter: the remaining text
                    }
                    else
                    {
                        return (1, 0, code);
                        // 1: "code starts with a letter"
                        // 0: no number
                        // code: entire string
                    }
                }
            ))
            {
                <div class="cart-product">
                    @if (cartProduct.Product.Category == ProductCategory.Extras)
                    {
                        <span class="product-code"></span>
                    }
                    else
                    {
                        <span class="product-code">
                            @if (cartProduct is CartFoodProduct cfp)
                            {
                                @cartProduct.Product.Code
                                @(cfp.FoodOption.HasValue ? cfp.FoodOption.Value.ToString().Substring(0, 1) : null)
                            }
                        </span>
                    }
                    <span class="product-name">
                        @if (cartProduct is CartFoodProduct cartFoodProduct)
                        {
                            @cartFoodProduct.Product.Name
                            @if (cartFoodProduct.Product.HasOptions)
                            {
                                @(cartFoodProduct.FoodOption.HasValue ? cartFoodProduct.FoodOption.Value.ToString() : "")
                            }
                        }
                        else if (cartProduct is CartSauceProduct cartSauceProduct) {
                            @Html.DisplayFor(model => cartSauceProduct.SauceOption)
                        }
                    </span>
                    <span class="product-price">@cartProduct.Product.Price.ToString("C", new CultureInfo("en-CA"))</span>
                    <span class="product-additional-price">
                        @cartProduct.AdditionalPrice.ToString("C", new CultureInfo("en-CA"))
                        <button class="button button-additional-price"><i class="fa-solid fa-pen-to-square"></i></button>
                        <partial name="_ProductsAdditionalPriceAndInstructionsModal" model="cartProduct" />
                    </span>
                    <span class="product-quantity">@cartProduct.Quantity</span>
                    <span class="product-total-price">@cartProduct.TotalPrice.ToString("C", new CultureInfo("en-CA"))</span>
                    <a asp-action="IncrementProduct" asp-controller="Cart" asp-route-id="@cartProduct.Id"><span class="button product-increment">+</span></a>
                    <a asp-action="DecrementProduct" asp-controller="Cart" asp-route-id="@cartProduct.Id"><span class="button product-decrement">-</span></a>
                </div>
            }
        </div>
        <partial name="_OrderForm" />
    }
</div>

@section Scripts {
    <script src="~/js/Shared/order-form.js"></script>
    <script src="~/js/additionalPriceModal.js"></script>
}
